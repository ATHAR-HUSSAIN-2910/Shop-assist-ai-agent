# ==========================================================
# ShopAssist AI — Environment Variables
# ==========================================================
# Copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# NEVER commit the real `.env` file to GitHub.
# ==========================================================


# ----------------------------------------------------------
# Groq API (for LLM inference)
# ----------------------------------------------------------
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here


# ----------------------------------------------------------
# PostgreSQL / Supabase (for order data + LangGraph checkpoints)
# ----------------------------------------------------------
# Get this from Supabase:
#   Project Settings → Database → Connection string → URI
# Replace `[YOUR-PASSWORD]` with your actual database password.
#
# Example format:
#   postgresql://postgres.abcdefghijklm:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@host:5432/database_name